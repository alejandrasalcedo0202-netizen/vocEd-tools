<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Clear Channels | Communication Protocols Challenge</title>
<meta name="description" content="LAUSD DACE Central Office comprehension check on internal and external communication protocols.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#002870; --navy2:#003594; --navy3:#0a3aa8; --ink:#0b1a3d;
  --gold:#FACC15; --gold2:#F5A623; --orange:#EC5C2A; --sky:#1A8FFF;
  --green:#16a34a; --red:#dc2626; --paper:#ffffff; --mist:#eef3ff;
  --shadow:0 18px 40px rgba(0,20,70,.25);
}
*{box-sizing:border-box;margin:0;padding:0}
html{background:#002870}
html,body{min-height:100%}
body{font-family:'Poppins',system-ui,sans-serif;color:#fff;background:var(--navy);
  background-image:radial-gradient(1200px 600px at 110% -10%,var(--navy3) 0,transparent 60%),radial-gradient(900px 500px at -20% 110%,#001a4d 0,transparent 60%);
  min-height:100vh;overflow-x:hidden}
button{font-family:inherit;cursor:pointer;border:0}
.app{max-width:760px;margin:0 auto;padding:16px 16px 40px;min-height:100vh;display:flex;flex-direction:column}

/* top bar */
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.logo-chip{background:#fff;border-radius:14px;padding:8px 12px;display:flex;align-items:center;box-shadow:var(--shadow)}
.logo-chip img{height:30px;display:block}
.hud{display:flex;gap:8px;align-items:center}
.pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:6px 14px;font-weight:600;font-size:15px;display:flex;align-items:center;gap:6px;white-space:nowrap}
.pill .lbl{font-weight:500;opacity:.75;font-size:12px;text-transform:uppercase;letter-spacing:.06em}
.pill.score b{color:var(--gold)}
.streak{transition:transform .2s}
.streak.hot{background:var(--orange);border-color:var(--orange)}
.streak.bump{transform:scale(1.15)}
.icon-btn{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:#fff;display:grid;place-items:center}
.icon-btn svg{width:18px;height:18px}

/* progress */
.rounds{display:flex;gap:6px;margin-bottom:18px}
.rounds .seg{flex:1;height:8px;border-radius:99px;background:rgba(255,255,255,.14);overflow:hidden}
.rounds .seg i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:99px;transition:width .5s ease}

/* screens */
.screen{flex:1;display:flex;flex-direction:column;animation:enter .45s cubic-bezier(.2,.8,.2,1)}
@keyframes enter{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}
.card{background:var(--paper);color:var(--ink);border-radius:24px;padding:24px;box-shadow:var(--shadow);position:relative}
.kicker{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.card .kicker{color:var(--orange)}
h1{font-size:clamp(36px,8vw,56px);line-height:1.02;font-weight:800;letter-spacing:-.02em}
h2{font-size:clamp(22px,4.6vw,28px);line-height:1.25;font-weight:700;letter-spacing:-.01em}
.lead{font-size:17px;opacity:.9;line-height:1.55}
.muted{color:#51607f}

/* intro */
.hero{padding:22px 4px 8px}
.hero h1 span{color:var(--gold)}
.hero .tag{display:inline-flex;gap:8px;align-items:center;background:var(--orange);color:#fff;font-weight:600;border-radius:999px;padding:6px 16px;margin:18px 0 14px;font-size:15px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}
.stat{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:14px;text-align:center}
.stat b{display:block;font-size:28px;font-weight:800;color:var(--gold)}
.stat span{font-size:13px;opacity:.85}
.field{display:flex;flex-direction:column;gap:6px;margin:6px 0 18px}
.field label{font-size:14px;font-weight:600}
.field input{font-family:inherit;font-size:17px;padding:14px 16px;border-radius:14px;border:2px solid rgba(255,255,255,.2);background:rgba(255,255,255,.95);color:var(--ink);outline:none}
.field input:focus{border-color:var(--gold)}
.cta{background:var(--gold);color:var(--ink);font-weight:800;font-size:18px;padding:16px 26px;border-radius:16px;box-shadow:0 8px 0 var(--gold2);transition:transform .1s,box-shadow .1s;display:inline-flex;align-items:center;justify-content:center;gap:10px}
.cta:active{transform:translateY(6px);box-shadow:0 2px 0 var(--gold2)}
.cta[disabled]{opacity:.45;cursor:not-allowed}
.cta.alt{background:#fff;box-shadow:0 8px 0 #c9d4ee}
.cta.block{width:100%}
.legend{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.legend span{font-size:13px;background:rgba(255,255,255,.08);border-radius:999px;padding:6px 12px}

/* round splash */
.splash{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:20px 4px}
.splash .num{font-size:clamp(90px,24vw,160px);font-weight:800;line-height:.9;color:transparent;-webkit-text-stroke:2px var(--gold);letter-spacing:-.04em}
.splash h2{font-size:clamp(30px,7vw,44px);margin:8px 0 10px}
.splash .lead{max-width:520px;margin-bottom:26px}
.splash .rule{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);padding:8px 14px;border-radius:12px;font-size:14px;margin-bottom:24px}

/* question */
.qmeta{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:14px;font-weight:600;opacity:.9}
.scenario{display:flex;gap:12px;align-items:flex-start;background:var(--mist);border-radius:16px;padding:14px 16px;margin:14px 0 18px;font-size:15px;line-height:1.5;color:#22325a}
.scenario svg{flex:none;width:22px;height:22px;color:var(--navy2);margin-top:2px}
.opts{display:grid;gap:10px}
.opt{display:flex;align-items:center;gap:14px;text-align:left;background:#fff;border:2px solid #dbe3f5;border-radius:16px;padding:14px 16px;font-size:16px;font-weight:500;color:var(--ink);transition:transform .12s,border-color .15s,background .15s}
.opt:hover:not([disabled]){border-color:var(--navy2);transform:translateY(-2px)}
.opt .key{flex:none;width:34px;height:34px;border-radius:10px;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px}
.opt.correct{border-color:var(--green);background:#ecfdf3}
.opt.correct .key{background:var(--green)}
.opt.wrong{border-color:var(--red);background:#fef2f2;animation:shake .4s}
.opt.wrong .key{background:var(--red)}
.opt[disabled]{cursor:default}
.opt.dim{opacity:.5}
@keyframes shake{20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}

.feedback{margin-top:16px;border-radius:16px;padding:14px 16px;display:none;gap:12px;align-items:flex-start;font-size:15px;line-height:1.5}
.feedback.show{display:flex;animation:enter .3s}
.feedback.good{background:#ecfdf3;color:#14532d}
.feedback.bad{background:#fff7ed;color:#7c2d12}
.feedback b{display:block;font-size:16px}
.feedback .ic{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:#fff}
.feedback.good .ic{background:var(--green)} .feedback.bad .ic{background:var(--orange)}
.next-row{margin-top:16px;display:none}
.next-row.show{display:block}
.float{position:fixed;pointer-events:none;font-weight:800;font-size:26px;color:var(--gold);text-shadow:0 2px 0 rgba(0,0,0,.25);animation:floatUp 1s ease-out forwards;z-index:50}
@keyframes floatUp{from{opacity:1;transform:translate(-50%,0)}to{opacity:0;transform:translate(-50%,-70px)}}

/* chain builder */
.slots{display:grid;gap:8px;margin:16px 0}
.slot{display:flex;align-items:center;gap:12px;border:2px dashed #b9c6e6;border-radius:14px;padding:12px 14px;min-height:56px;color:#7a88a8;font-weight:500;transition:all .15s}
.slot .n{flex:none;width:30px;height:30px;border-radius:50%;background:#e5ebf8;color:var(--navy);display:grid;place-items:center;font-weight:700}
.slot.filled{border-style:solid;border-color:var(--navy2);background:#f3f6ff;color:var(--ink);cursor:pointer}
.slot.filled .n{background:var(--navy);color:#fff}
.slot.ok{border-color:var(--green);background:#ecfdf3}.slot.ok .n{background:var(--green)}
.slot.no{border-color:var(--red);background:#fef2f2}.slot.no .n{background:var(--red);color:#fff}
.slot .arrow{margin-left:auto;opacity:.4}
.tiles{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
.tile{background:var(--navy);color:#fff;padding:12px 16px;border-radius:12px;font-weight:600;font-size:15px;transition:transform .12s,opacity .2s}
.tile:hover{transform:translateY(-2px)}
.tile.used{opacity:.2;pointer-events:none}
.hint{font-size:13px;color:#6a7899;margin-top:4px}

/* lightning */
.timer{height:10px;border-radius:99px;background:#e5ebf8;overflow:hidden;margin:6px 0 18px}
.timer i{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--orange),var(--gold));transform-origin:left}
.statement{font-size:clamp(20px,4.5vw,26px);font-weight:600;line-height:1.35;min-height:110px;display:flex;align-items:center}
.tf{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}
.tf button{border-radius:18px;padding:18px 12px;font-size:18px;font-weight:800;color:#fff;display:flex;flex-direction:column;align-items:center;gap:6px;transition:transform .12s,opacity .2s}
.tf button small{font-weight:500;font-size:13px;opacity:.9}
.tf .yes{background:var(--green);box-shadow:0 6px 0 #0f7a37}
.tf .no{background:var(--red);box-shadow:0 6px 0 #9d1b1b}
.tf button:active{transform:translateY(4px)}
.tf button[disabled]{opacity:.35}
.tf button.picked{opacity:1;outline:4px solid var(--gold);outline-offset:3px}
.bolt{display:inline-flex;align-items:center;gap:6px;background:var(--gold);color:var(--ink);font-weight:700;border-radius:999px;padding:4px 12px;font-size:13px}

/* results */
.results{text-align:center}
.ring{position:relative;width:190px;height:190px;margin:8px auto 10px}
.ring svg{transform:rotate(-90deg)}
.ring .center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .center b{font-size:44px;font-weight:800;line-height:1}
.ring .center > span{font-size:13px;opacity:.8}
.points{font-size:15px;opacity:.9;margin-bottom:6px}
.points b{color:var(--gold);font-size:22px}
.rank{display:inline-block;background:rgba(255,255,255,.12);border-radius:999px;padding:6px 16px;font-weight:700;margin:6px 0 18px}

.badge-wrap{perspective:900px;margin:10px auto 18px;max-width:420px}
.badge{background:linear-gradient(160deg,#fff 0,#fff 55%,#fff8dc 100%);color:var(--ink);border-radius:26px;padding:26px 22px 22px;box-shadow:0 24px 60px rgba(0,0,0,.35);position:relative;overflow:hidden;animation:badgeIn 1s cubic-bezier(.2,1.4,.3,1) both}
@keyframes badgeIn{from{transform:rotateY(90deg) scale(.6);opacity:0}to{transform:none;opacity:1}}
.badge:before{content:"";position:absolute;inset:-40%;background:conic-gradient(from 0deg,transparent 0 40deg,rgba(250,204,21,.25) 60deg,transparent 80deg 220deg,rgba(236,92,42,.18) 240deg,transparent 260deg);animation:spin 8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.badge > *{position:relative}
.medal{width:120px;height:120px;margin:0 auto 10px}
.badge .title{font-size:13px;letter-spacing:.16em;font-weight:700;color:var(--orange);text-transform:uppercase}
.badge h3{font-size:30px;font-weight:800;line-height:1.1;margin:4px 0 4px;color:var(--navy)}
.badge .who{font-size:20px;font-weight:600;margin:10px 0 2px}
.badge .meta{font-size:13px;color:#51607f}
.badge .code{display:inline-block;margin-top:12px;font-weight:700;letter-spacing:.12em;background:var(--navy);color:var(--gold);padding:8px 14px;border-radius:10px;font-size:15px}
.badge .claim{margin-top:12px;font-size:14px;font-weight:600;color:var(--navy)}
.badge .logo-line{margin-top:14px;display:flex;justify-content:center}
.badge .logo-line img{height:26px}

.review{text-align:left;margin-top:18px}
.review h3{font-size:18px;margin-bottom:10px}
.review li{list-style:none;background:var(--mist);border-radius:14px;padding:12px 14px;margin-bottom:8px;font-size:14px;line-height:1.5;color:#22325a}
.review li b{color:var(--navy)}
.actions{display:grid;gap:12px;margin-top:20px}
.foot{margin-top:28px;text-align:center;font-size:12px;opacity:.7}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:40}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
@media (min-width:640px){.card{padding:32px}.app{padding-top:24px}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="confetti"></canvas>
<div class="app">
  <div class="top">
    <div class="logo-chip"><img src="data:image/png;base64," alt="LAUSD Unified"></div>
    <div class="hud" id="hud">
      <div class="pill streak" id="streakPill" title="Streak"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 1s1 3.5-1.5 6.5S7 11.5 7 15a5 5 0 0 0 10 0c0-2-1-3.5-1-3.5s2.5 1 2.5 4.5A6.5 6.5 0 0 1 12 22.5 6.5 6.5 0 0 1 5.5 16C5.5 9 13.5 7 13.5 1z"/></svg><span id="streak">0</span></div>
      <div class="pill score"><span class="lbl">Pts</span><b id="score">0</b></div>
      <button class="icon-btn" id="soundBtn" aria-label="Turn music and sound on" title="Music and sound"></button>
    </div>
  </div>
  <div class="rounds" id="rounds" style="visibility:hidden"><div class="seg"><i></i></div><div class="seg"><i></i></div><div class="seg"><i></i></div></div>
  <main id="stage"></main>
  <div class="foot">LAUSD Division of Adult and Career Education · Central Office · Clarity is Kindness</div>
</div>
<div aria-live="polite" class="sr" id="live"></div>

<script>
/* ---------- CONTENT (edit questions here) ---------- */
const CHAIN = ["Immediate Supervisor","Team Lead","Division Leadership","Executive Director"];

const ROUNDS = [
 { id:"chain", title:"Build the Chain", blurb:"Put the internal communication chain in order, from the first stop to the last.", rule:"Tap the levels in order. Tap a filled slot to undo." },
 { id:"next", title:"Your Next Move", blurb:"Three real situations, inside the office and with schools. Pick the move that follows protocol.", rule:"100 points per correct answer, plus streak bonuses.",
   items:[
    { k:"Internal protocol", s:"You have a routine question about logging an off-site day at a school.", q:"Who do you go to first?",
      o:["The Executive Director","Your immediate supervisor","Whoever is free in the office","Division Leadership"], a:1,
      why:"Start with your supervisor: routine questions begin at the first level, where most can be resolved." },
    { k:"External (field) protocol", s:"A School Administrative Assistant (SAA) texts your personal cell asking about a form.", q:"What is the best response?",
      o:["Answer quickly by text, it's easier","Give them your personal number for next time","Ignore the text","Respond from your LAUSD email or work line and copy your team"], a:3,
      why:"Avoid personal cell phones: move the conversation to a district channel so there's a record and your team can follow up." },
    { k:"External (field) protocol", s:"Your team is announcing a procedure change to every school.", q:"Which approach keeps the message consistent?",
      o:["Each person tells their own schools in their own words","Coordinate one message so all schools get the same information at the same time","Only tell schools that ask","Post it to a personal social account"], a:1,
      why:"One consistent message: coordinated communication means every school hears the same thing at the same time." }
   ]},
 { id:"lightning", title:"Lightning Round", blurb:"Three quick statements. Is it a Protocol to follow or a Pitfall to avoid? Faster answers earn bonus points.", rule:"10 seconds per statement. Speed bonus up to +50.",
   items:[
    { t:"Texting a principal from my personal phone is fine if it's quick.", a:false, why:"Pitfall: use your LAUSD email or work phone for district business." },
    { t:"Copying my supervisor on field communication keeps everyone aware.", a:true, why:"Protocol: keep your team aware." },
    { t:"For routine matters, going straight to the Executive Director saves time.", a:false, why:"Pitfall: follow the chain; don't bypass it for routine matters." }
   ]}
];
const TOTAL = ROUNDS.reduce((n,r)=>n+(r.items?r.items.length:1),0);
const NR = ROUNDS.length;

/* ---------- STATE ---------- */
const S = { name:"", score:0, streak:0, best:0, correct:0, misses:[], round:0, step:0, sound:false };
const $ = s => document.querySelector(s);
const stage = $("#stage");
const live = msg => { $("#live").textContent = msg; };
const esc = t => String(t).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const shuffle = a => { a = a.slice(); for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; };
const ICON = {
  check:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
  x:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>',
  chat:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"/></svg>',
  arrow:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  on:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>',
  off:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>'
};

/* ---------- SOUND (off by default) ---------- */
let ctx;
function tone(freqs, dur=.12, type="sine"){
  if(!S.sound) return;
  try{
    ctx = ctx || new (window.AudioContext||window.webkitAudioContext)();
    freqs.forEach((f,i)=>{ const o=ctx.createOscillator(), g=ctx.createGain(); o.type=type; o.frequency.value=f;
      const t=ctx.currentTime+i*dur; g.gain.setValueAtTime(.0001,t); g.gain.exponentialRampToValueAtTime(.18,t+.02); g.gain.exponentialRampToValueAtTime(.0001,t+dur*1.6);
      o.connect(g).connect(ctx.destination); o.start(t); o.stop(t+dur*1.8); });
  }catch(e){}
}
const sfx = { good:()=>tone([660,880],.09), bad:()=>tone([220,180],.14,"triangle"), win:()=>tone([523,659,784,1047],.12) };
function paintSound(){ const b=$("#soundBtn"); b.innerHTML = S.sound?ICON.on:ICON.off; b.setAttribute("aria-label", S.sound?"Turn music and sound off":"Turn music and sound on"); }
/* ---------- BACKGROUND MUSIC (generated live, no audio files) ---------- */
const M = { timer:null, next:0, step:0, fast:false, bus:null };
const mtof = n => 440*Math.pow(2,(n-69)/12);
const CHORDS = [[48,55,60,64],[43,50,55,59],[45,52,57,60],[41,48,53,57]]; // C, G, Am, F
function mNote(freq,t,dur,type,vol){
  const o=ctx.createOscillator(), g=ctx.createGain(); o.type=type; o.frequency.value=freq;
  g.gain.setValueAtTime(.0001,t); g.gain.exponentialRampToValueAtTime(vol,t+.01); g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  o.connect(g).connect(M.bus); o.start(t); o.stop(t+dur+.05);
}
let noiseBuf;
function mHat(t,vol){
  if(!noiseBuf){ noiseBuf=ctx.createBuffer(1,ctx.sampleRate*.05,ctx.sampleRate); const d=noiseBuf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1; }
  const src=ctx.createBufferSource(), hp=ctx.createBiquadFilter(), g=ctx.createGain();
  src.buffer=noiseBuf; hp.type="highpass"; hp.frequency.value=7000; g.gain.setValueAtTime(vol,t); g.gain.exponentialRampToValueAtTime(.0001,t+.04);
  src.connect(hp).connect(g).connect(M.bus); src.start(t);
}
function mKick(t){
  const o=ctx.createOscillator(), g=ctx.createGain(); o.frequency.setValueAtTime(140,t); o.frequency.exponentialRampToValueAtTime(45,t+.12);
  g.gain.setValueAtTime(.5,t); g.gain.exponentialRampToValueAtTime(.0001,t+.18); o.connect(g).connect(M.bus); o.start(t); o.stop(t+.2);
}
function mPlay(step,t){
  const bar=Math.floor(step/16)%4, s=step%16, ch=CHORDS[bar], sixteenth=60/(M.fast?136:112)/4;
  if(s===0||s===8) mKick(t);
  if(s%4===2) mHat(t, M.fast?.12:.08);
  if(M.fast && s%2===1) mHat(t,.04);
  if(s===0||s===6||s===8||s===14) mNote(mtof(ch[0]-12),t,sixteenth*2.2,"triangle",.22);
  if(s%2===0){ const arp=[0,1,2,3,2,1,0,2][(s/2)%8]; mNote(mtof(ch[arp]+12),t,sixteenth*1.6,"square",.035); }
  if(s===0) ch.slice(1).forEach(n=>mNote(mtof(n),t,sixteenth*15,"sine",.04));
}
function musicStart(){
  try{ ctx = ctx || new (window.AudioContext||window.webkitAudioContext)(); ctx.resume(); }catch(e){ return; }
  if(M.timer) return;
  if(!M.bus){ M.bus=ctx.createGain(); M.bus.gain.value=.55; M.bus.connect(ctx.destination); }
  M.bus.gain.cancelScheduledValues(ctx.currentTime); M.bus.gain.setValueAtTime(.55,ctx.currentTime);
  M.next=ctx.currentTime+.05;
  M.timer=setInterval(()=>{ while(M.next<ctx.currentTime+.15){ mPlay(M.step,M.next); M.next+=60/(M.fast?136:112)/4; M.step++; } },25);
}
function musicStop(){ clearInterval(M.timer); M.timer=null; if(M.bus){ M.bus.gain.setTargetAtTime(.0001,ctx.currentTime,.08); } }
$("#soundBtn").onclick = ()=>{ S.sound=!S.sound; paintSound(); if(S.sound){ musicStart(); sfx.good(); } else musicStop(); };
paintSound();

/* ---------- HUD ---------- */
function hud(){
  $("#score").textContent = S.score.toLocaleString();
  $("#streak").textContent = S.streak;
  const p = $("#streakPill"); p.classList.toggle("hot", S.streak>=3);
  p.classList.remove("bump"); void p.offsetWidth; if(S.streak>0) p.classList.add("bump");
  document.querySelectorAll("#rounds .seg i").forEach((el,i)=>{
    const r = ROUNDS[i]; const n = r.items ? r.items.length : 1;
    el.style.width = (i < S.round ? 100 : i===S.round ? Math.round(100*S.step/n) : 0) + "%";
  });
}
function floatPts(el, txt){
  const r = el.getBoundingClientRect(); const f = document.createElement("div");
  f.className="float"; f.textContent=txt; f.style.left=(r.left+r.width/2)+"px"; f.style.top=(r.top+window.scrollY-10)+"px"; f.style.position="absolute";
  document.body.appendChild(f); setTimeout(()=>f.remove(),1000);
}
function award(ok, el, bonus=0, missText){
  if(ok){
    S.correct++; S.streak++; S.best=Math.max(S.best,S.streak);
    const streakBonus = S.streak>=2 ? Math.min((S.streak-1)*25,100) : 0;
    const pts = 100 + streakBonus + bonus; S.score += pts;
    floatPts(el, "+"+pts); sfx.good();
  } else {
    S.streak = 0; sfx.bad(); if(missText) S.misses.push(missText);
  }
  hud();
}

/* ---------- SCREENS ---------- */
function intro(){
  stage.innerHTML = `
  <section class="screen hero">
    <div class="kicker">2-Minute Check · Communication Protocols</div>
    <h1>Clear <span>Channels</span><br>Challenge</h1>
    <div class="tag">Clarity is Kindness</div>
    <p class="lead">Quick check on internal and field communication. Get them all right to earn the <b>Clear Channels Champion</b> badge.</p>
    <div class="stats">
      <div class="stat"><b>${NR}</b><span>rounds</span></div>
      <div class="stat"><b>${TOTAL}</b><span>challenges</span></div>
      <div class="stat"><b>2</b><span>minutes</span></div>
    </div>
    <button class="cta block" id="go">Start the challenge ${ICON.arrow}</button>
    <div class="legend"><span>+100 per correct answer</span><span>Streak bonus up to +100</span><span>Speed bonus in the lightning round</span></div>
  </section>`;
  $("#go").onclick = ()=>{ $("#rounds").style.visibility="visible"; splash(0); };
}

function splash(r){
  S.round=r; S.step=0; M.fast=false; hud();
  const R = ROUNDS[r];
  stage.innerHTML = `
  <section class="screen splash">
    <div class="kicker">Round ${r+1} of ${NR}</div>
    <div class="num">0${r+1}</div>
    <h2>${R.title}</h2>
    <p class="lead">${R.blurb}</p>
    <div class="rule">${R.id==="lightning"?'<span class="bolt">Speed bonus</span>':''}${R.rule}</div>
    <button class="cta" id="go">${r===0?"Let's go":"Start round "+(r+1)} ${ICON.arrow}</button>
  </section>`;
  $("#go").onclick = ()=>{ if(R.id==="chain") chain(); else if(R.id==="lightning") lightning(); else mcq(); };
  $("#go").focus();
}

/* Round 1: chain builder */
function chain(){
  const picks = [];
  const pool = shuffle(CHAIN);
  stage.innerHTML = `
  <section class="screen">
    <div class="qmeta"><span>Round 1 · Build the Chain</span><span>1 / 1</span></div>
    <div class="card">
      <div class="kicker">Internal protocol</div>
      <h2>Where does a question travel, in order?</h2>
      <div class="slots" id="slots"></div>
      <div class="tiles" id="tiles"></div>
      <div class="hint">Tap a level to place it in the next open slot.</div>
      <div class="feedback" id="fb"></div>
      <div class="next-row show" id="checkRow"><button class="cta block" id="check" disabled>Check my chain</button></div>
      <div class="next-row" id="nextRow"><button class="cta block" id="next">Next round ${ICON.arrow}</button></div>
    </div>
  </section>`;
  const paint = ()=>{
    $("#slots").innerHTML = CHAIN.map((_,i)=> picks[i]
      ? `<button class="slot filled" data-i="${i}"><span class="n">${i+1}</span>${esc(picks[i])}<span class="arrow">${i<3?"↓":""}</span></button>`
      : `<div class="slot"><span class="n">${i+1}</span>${i===picks.length?"Tap a level below":""}</div>`).join("");
    $("#tiles").innerHTML = pool.map(t=>`<button class="tile ${picks.includes(t)?"used":""}">${esc(t)}</button>`).join("");
    document.querySelectorAll(".tile").forEach(b=> b.onclick=()=>{ if(picks.length<4){ picks.push(b.textContent); tone([520+picks.length*80],.06); paint(); } });
    document.querySelectorAll(".slot.filled").forEach(b=> b.onclick=()=>{ picks.splice(+b.dataset.i,1); paint(); });
    $("#check").disabled = picks.length<4;
  };
  paint();
  $("#check").onclick = ()=>{
    const ok = picks.every((p,i)=>p===CHAIN[i]);
    document.querySelectorAll(".slot").forEach((el,i)=>{ el.classList.add(picks[i]===CHAIN[i]?"ok":"no"); el.onclick=null; el.style.cursor="default"; });
    document.querySelectorAll(".tile").forEach(t=>t.remove()); $(".hint").remove();
    award(ok, $("#check"), 0, "<b>Build the Chain:</b> " + CHAIN.join(" → "));
    const fb=$("#fb"); fb.className="feedback show "+(ok?"good":"bad");
    fb.innerHTML = `<span class="ic">${ok?ICON.check:ICON.x}</span><div><b>${ok?"Perfect chain!":"Not quite."}</b>${ok?"":"The chain is "+CHAIN.join(" → ")+". "}Start with your supervisor and elevate only when needed.</div>`;
    live(ok?"Correct":"Incorrect");
    S.step=1; hud();
    $("#checkRow").classList.remove("show"); $("#nextRow").classList.add("show"); $("#next").focus();
  };
  $("#next").onclick = ()=> splash(1);
}

/* Rounds 2 and 3: scenario multiple choice */
function mcq(){
  const R = ROUNDS[S.round], it = R.items[S.step], letters="ABCD";
  const order = shuffle([0,1,2,3]);
  stage.innerHTML = `
  <section class="screen">
    <div class="qmeta"><span>Round ${S.round+1} · ${R.title}</span><span>${S.step+1} / ${R.items.length}</span></div>
    <div class="card">
      <div class="kicker">${it.k}</div>
      <div class="scenario">${ICON.chat}<span>${esc(it.s)}</span></div>
      <h2>${esc(it.q)}</h2>
      <div class="opts" style="margin-top:16px">${order.map((oi,k)=>`<button class="opt" data-oi="${oi}"><span class="key">${letters[k]}</span><span>${esc(it.o[oi])}</span></button>`).join("")}</div>
      <div class="feedback" id="fb"></div>
      <div class="next-row" id="nextRow"><button class="cta block" id="next"></button></div>
    </div>
  </section>`;
  document.querySelectorAll(".opt").forEach(btn=> btn.onclick=()=>{
    const pick=+btn.dataset.oi, ok = pick===it.a;
    document.querySelectorAll(".opt").forEach(b=>{ b.disabled=true; const oi=+b.dataset.oi;
      if(oi===it.a) b.classList.add("correct"); else if(b===btn) b.classList.add("wrong"); else b.classList.add("dim"); });
    award(ok, btn, 0, `<b>${esc(it.q)}</b> ${esc(it.o[it.a])}`);
    const fb=$("#fb"); fb.className="feedback show "+(ok?"good":"bad");
    fb.innerHTML=`<span class="ic">${ok?ICON.check:ICON.x}</span><div><b>${ok?(S.streak>=3?"On fire! "+S.streak+" in a row.":"Correct!"):"Good try."}</b>${esc(it.why)}</div>`;
    live(ok?"Correct":"Incorrect. "+it.why);
    S.step++; hud();
    const last = S.step>=R.items.length;
    $("#next").innerHTML = (last?"Next round":"Next question")+" "+ICON.arrow;
    $("#nextRow").classList.add("show"); $("#next").focus();
    $("#next").onclick = ()=> last ? splash(S.round+1) : mcq();
  });
}

/* Round 4: lightning */
let tick;
function lightning(){
  const R = ROUNDS[S.round], it = R.items[S.step], LIMIT=10000; M.fast=true;
  stage.innerHTML = `
  <section class="screen">
    <div class="qmeta"><span>Round ${S.round+1} · Lightning</span><span>${S.step+1} / ${R.items.length}</span></div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center"><span class="kicker">Protocol or Pitfall?</span><span class="bolt" id="secs">10s</span></div>
      <div class="timer"><i id="bar"></i></div>
      <div class="statement">“${esc(it.t)}”</div>
      <div class="tf">
        <button class="yes" data-v="1">Protocol<small>Follow it</small></button>
        <button class="no" data-v="0">Pitfall<small>Avoid it</small></button>
      </div>
      <div class="feedback" id="fb"></div>
    </div>
  </section>`;
  const start = performance.now(); let done=false;
  const finish = (val, btn)=>{
    if(done) return; done=true; cancelAnimationFrame(tick);
    const left = Math.max(0, LIMIT-(performance.now()-start));
    const ok = val!==null && val===it.a;
    document.querySelectorAll(".tf button").forEach(b=>{ b.disabled=true; });
    if(btn) btn.classList.add("picked");
    const bonus = ok ? Math.round(50*left/LIMIT) : 0;
    award(ok, btn||$(".statement"), bonus, `<b>“${esc(it.t)}”</b> ${esc(it.why)}`);
    const fb=$("#fb"); fb.className="feedback show "+(ok?"good":"bad");
    fb.innerHTML=`<span class="ic">${ok?ICON.check:ICON.x}</span><div><b>${val===null?"Time's up!":ok?"Correct! +"+bonus+" speed bonus":"Not this time."}</b>${esc(it.why)}</div>`;
    live((ok?"Correct. ":"Incorrect. ")+it.why);
    S.step++; hud();
    setTimeout(()=> S.step>=R.items.length ? results() : lightning(), 1900);
  };
  document.querySelectorAll(".tf button").forEach(b=> b.onclick=()=>finish(b.dataset.v==="1", b));
  const loop = now=>{
    const left = Math.max(0, LIMIT-(now-start));
    $("#bar").style.transform=`scaleX(${left/LIMIT})`; $("#secs").textContent=Math.ceil(left/1000)+"s";
    if(left<=0) return finish(null,null);
    tick=requestAnimationFrame(loop);
  };
  tick=requestAnimationFrame(loop);
}

/* Results */
function results(){
  S.round=NR; M.fast=false; hud();
  const perfect = S.correct===TOTAL, pct = S.correct/TOTAL;
  const rank = perfect?"Clear Channels Champion":pct>=.8?"Protocol Pro":pct>=.6?"Rising Communicator":"Protocol Explorer";
  const C = 2*Math.PI*80;
  stage.innerHTML = `
  <section class="screen results">
    <div class="kicker">Challenge complete</div>
    <div class="ring">
      <svg width="190" height="190"><circle cx="95" cy="95" r="80" stroke="rgba(255,255,255,.15)" stroke-width="14" fill="none"/>
      <circle id="arc" cx="95" cy="95" r="80" stroke="${perfect?"#FACC15":"#EC5C2A"}" stroke-width="14" fill="none" stroke-linecap="round" stroke-dasharray="${C}" stroke-dashoffset="${C}" style="transition:stroke-dashoffset 1.4s cubic-bezier(.2,.8,.2,1)"/></svg>
      <div class="center"><b><span id="cnt">0</span>/${TOTAL}</b><span>correct</span></div>
    </div>
    <div class="points"><b id="pts">0</b> points · best streak ${S.best}</div>
    <div class="rank">${rank}</div>
    ${perfect ? `
    <div class="badge-wrap"><div class="badge">
      <svg class="medal" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M38 4h16l12 30H50z" fill="#EC5C2A"/><path d="M82 4H66L54 34h16z" fill="#1A8FFF"/>
        <circle cx="60" cy="72" r="42" fill="#F5A623"/><circle cx="60" cy="72" r="34" fill="#FACC15"/>
        <circle cx="60" cy="72" r="34" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2" stroke-dasharray="3 5"/>
        <path d="M60 50l6.5 13.2 14.5 2.1-10.5 10.2 2.5 14.5L60 83.2 47 90l2.5-14.5L39 65.3l14.5-2.1z" fill="#002870"/>
      </svg>
      <div class="title">Perfect score · ${TOTAL}/${TOTAL}</div>
      <h3>Clear Channels Champion</h3>
      <div class="meta">Communication Protocols</div>
    </div></div>` : `
    <p class="lead" style="max-width:480px;margin:0 auto">So close! A perfect ${TOTAL}/${TOTAL} unlocks the <b>Clear Channels Champion</b> badge and a reward. Review below, then take another run.</p>`}
    ${S.misses.length?`<div class="review card"><h3>Review what you missed</h3><ul>${S.misses.map(m=>`<li>${m}</li>`).join("")}</ul></div>`:""}
    <div class="actions">
      <button class="cta ${perfect?"alt":""} block" id="again">${perfect?"Play again":"Try for a perfect score"}</button>
    </div>
  </section>`;
  requestAnimationFrame(()=>{ $("#arc").style.strokeDashoffset = C*(1-pct); });
  countUp($("#cnt"), S.correct, 900); countUp($("#pts"), S.score, 1400, true);
  if(perfect){ sfx.win(); confetti(); setTimeout(confetti,900); }
  live(`You got ${S.correct} of ${TOTAL} correct with ${S.score} points.`);
  $("#again").onclick = ()=>{ Object.assign(S,{score:0,streak:0,best:0,correct:0,misses:[],round:0,step:0}); hud(); splash(0); };
}
function countUp(el, to, ms, fmt){
  const t0=performance.now(); const f=now=>{ const p=Math.min(1,(now-t0)/ms), v=Math.round(to*(1-Math.pow(1-p,3)));
    el.textContent = fmt? v.toLocaleString() : v; if(p<1) requestAnimationFrame(f); }; requestAnimationFrame(f);
}

/* Confetti */
function confetti(){
  if(matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const cv=$("#confetti"), c=cv.getContext("2d"); cv.width=innerWidth; cv.height=innerHeight;
  const cols=["#FACC15","#F5A623","#EC5C2A","#1A8FFF","#ffffff","#FF0000"];
  const P=Array.from({length:180},()=>({x:innerWidth/2+(Math.random()-.5)*120,y:innerHeight*.35,vx:(Math.random()-.5)*14,vy:-Math.random()*14-4,
    s:Math.random()*8+4,r:Math.random()*6,vr:(Math.random()-.5)*.3,c:cols[Math.floor(Math.random()*cols.length)]}));
  let f=0; const step=()=>{ c.clearRect(0,0,cv.width,cv.height);
    P.forEach(p=>{ p.vy+=.35; p.vx*=.99; p.x+=p.vx; p.y+=p.vy; p.r+=p.vr;
      c.save(); c.translate(p.x,p.y); c.rotate(p.r); c.fillStyle=p.c; c.fillRect(-p.s/2,-p.s/4,p.s,p.s/2); c.restore(); });
    if(++f<200) requestAnimationFrame(step); else c.clearRect(0,0,cv.width,cv.height); };
  step();
}

intro();
</script>
